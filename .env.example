# Supabase Client Configuration
# Supabase Dashboard -> Settings -> API bölümünden alın
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# API-Sports Configuration
# API-Sports panelinden alınan key (günde 100 request limit)
API_BASE=https://v3.football.api-sports.io
API_KEY=YOUR_API_SPORTS_KEY

# Telegram Bot Configuration
# BotFather'dan (@BotFather) yeni bot oluşturup token alın
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
# Bot'a /start komutunu gönderin, loglardan chat ID'nizi alın
ADMIN_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Application Configuration
NODE_ENV=development
TZ=Europe/Istanbul